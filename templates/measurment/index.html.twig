{% extends 'base.html.twig' %}

{% block title %}Forecasts{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0">Forecasts</h1>
        <a href="{{ path('app_measurment_new') }}" class="btn btn-primary">+ Add forecast</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Location</th>
                <th>Date</th>
                <th>Temperature</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for measurment in measurments %}
                <tr>
                    <td>{{ measurment.id }}</td>
                    <td>{{ measurment.location.city }}, {{ measurment.location.country }}</td>
                    <td>{{ measurment.date ? measurment.date|date('d.m.Y') : '' }}</td>
                    <td>{{ measurment.celsius }}&deg;C</td>
                    <td class="text-end text-nowrap">
                        <a href="{{ path('app_measurment_edit', {'id': measurment.id}) }}" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post"
                              action="{{ path('app_measurment_delete', {'id': measurment.id}) }}"
                              class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this forecast?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ measurment.id) }}">
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted">No forecasts found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
